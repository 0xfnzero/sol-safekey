{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-proxy-api-request",
    "allow-open-external-url",
    "allow-pick-source-directory",
    "allow-save-download-file",
    "allow-open-download-file-location"
  ]
}
